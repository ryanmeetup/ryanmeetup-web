# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Server only. Never expose as NEXT_PUBLIC_. SUPABASE_SERVICE_ROLE_KEY is
# accepted as a legacy alias if SUPABASE_SECRET_KEY is unset.
SUPABASE_SECRET_KEY=sb_secret_your-server-only-key

# --- Read-only MCP -----------------------------------------------------------
# Configure these only on the RMT deployment when enabling the private Claude
# Desktop connector. PRD must leave them unset. Store the SHA-256 hex digest
# here; the raw token belongs only in Claude Desktop's encrypted extension
# configuration.
TASKS_MCP_READ_ENABLED=false
TASKS_MCP_READ_TOKEN_SHA256=

# --- This deployment ---------------------------------------------------------
TASKS_APP_URL=https://tasks.ryanmeetup.com
NEXT_PUBLIC_TASKS_APP_URL=https://tasks.ryanmeetup.com
# Optional comma-separated preview/staging origins whose request URLs may be trusted.
TASKS_ALLOWED_ORIGINS=
# Required by the cron routes; they reject every request without it.
# Generate per instance with: openssl rand -base64 32
CRON_SECRET=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=re_your-key
# Digest sender. TASK_REMINDER_FROM_EMAIL, then RESEND_FROM_EMAIL, are the
# fallbacks if this is unset.
TASK_DIGEST_FROM_EMAIL=Ryan Meetup Tasks <tasks@your-verified-domain.com>
TASK_REMINDER_FROM_EMAIL=
RESEND_FROM_EMAIL=
# Quota ceilings shown on /admin/usage. Default to 100 and 3000.
RESEND_DAILY_QUOTA=
RESEND_MONTHLY_QUOTA=

# --- Google Calendar ---------------------------------------------------------
# Google Cloud OAuth web client. Add
# https://tasks.ryanmeetup.com/api/integrations/google-calendar/callback as an
# authorized redirect URI. Generate the token key with: openssl rand -base64 32
# The token key encrypts stored refresh tokens, so generate a fresh one per
# instance rather than sharing it.
GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
GOOGLE_CALENDAR_TOKEN_KEY=your-base64-encoded-32-byte-key
GOOGLE_CALENDAR_ID=

# --- Instance identity: build-time -------------------------------------------
# These compose identifiers and cannot be changed at runtime. The task key
# prefix appears in every task URL, so changing it breaks existing links.
# 1-10 alphanumeric characters starting with a letter, e.g. the RMT in RMT-142.
# Defaults to the neutral TASK, so set this at first deploy and leave it alone.
NEXT_PUBLIC_TASK_KEY_PREFIX=RMT
# Defaults to the task key prefix, producing versions like "RMT v0.9.0".
NEXT_PUBLIC_CHANGELOG_VERSION_PREFIX=

# --- Instance identity: runtime defaults -------------------------------------
# Everything below is only the DEFAULT for a value that /admin/settings can
# change at runtime; a stored instance_settings value wins. Unset values fall
# back to unbranded defaults -- the wordmark becomes "Workspace" -- so the Ryan
# Meetup deployment must set its own name and footer subtitle here, while a
# second instance is usually better configured from the UI after its first
# deploy. See docs/MULTI_INSTANCE.md.
# The only name the workspace has: the wordmark, the page title, the link
# preview title, and the digest email's header all read from it.
NEXT_PUBLIC_INSTANCE_NAME=Ryan Meetup
NEXT_PUBLIC_INSTANCE_DESCRIPTION=
NEXT_PUBLIC_INSTANCE_ACCENT=#ee1a25
# Root-relative path to an image in public/. Falls back to the name as text.
# An uploaded logo is stored in the instance-assets bucket instead.
NEXT_PUBLIC_INSTANCE_LOGO_PATH=
# Single letter in the Open Graph badge. Defaults to the first letter of name.
NEXT_PUBLIC_INSTANCE_MONOGRAM=
# Alt text for the link-preview image. The card itself prints the monogram,
# the name, and the description; it has no copy of its own.
NEXT_PUBLIC_INSTANCE_OG_ALT=
NEXT_PUBLIC_INSTANCE_FOOTER_SUBTITLE=NO BRYANS ALLOWED
NEXT_PUBLIC_INSTANCE_CREDIT_PREFIX=Website designed and developed by
NEXT_PUBLIC_INSTANCE_CREDIT_LABEL=Ryan Le
NEXT_PUBLIC_INSTANCE_CREDIT_URL=https://ryanle.dev/
NEXT_PUBLIC_INSTANCE_CREDIT_SUFFIX=. All Rights Reserved.

# Footer link columns and social icons are lists, not scalars, so they have no
# environment variables. Their build-time defaults live in lib/instance.ts and
# /admin/settings is where an instance changes them.
