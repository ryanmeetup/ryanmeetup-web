{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-preview/types/**/*.ts",
    ".next-preview/dev/types/**/*.ts",
    ".next-hostcheck/types/**/*.ts",
    ".next-hostcheck/dev/types/**/*.ts",
    ".next-e2e/product-reviews/types/**/*.ts",
    ".next-e2e/product-reviews/dev/types/**/*.ts",
    ".next-e2e/review-photos/types/**/*.ts",
    ".next-e2e/review-photos/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-e2e/product-reviews-d1/types/**/*.ts",
    ".next-e2e/product-reviews-d1/dev/types/**/*.ts",
    ".next-e2e/card-ratings/types/**/*.ts",
    ".next-e2e/card-ratings/dev/types/**/*.ts",
    ".next-promo-check/types/**/*.ts",
    ".next-promo-check/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
