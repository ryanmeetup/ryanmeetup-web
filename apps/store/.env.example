SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=your-public-storefront-token
SHOPIFY_ADMIN_API_TOKEN=server-only-admin-token
# Signing secret for the webhook subscriptions (not an API access token).
SHOPIFY_WEBHOOK_SECRET=server-only-webhook-signing-secret
# Custom reviews and buyer sign-in store their data in the shared Ryan Meetup
# backend (RMT) only. Server-only secret key; any other project is refused.
SUPABASE_URL=https://lvfaartgcpphuokoswcm.supabase.co
SUPABASE_SECRET_KEY=
# Shopify shop whose reviews this store reads and writes (also used by sign-in).
SHOPIFY_CUSTOMER_ACCOUNT_SHOP_ID=71870054511
# Custom buyer sign-in. Create a CONFIDENTIAL Customer Account API client in the
# Headless channel. Sign-in stays closed until this is exactly true.
STORE_CUSTOMER_ACCOUNT_SIGN_IN_ENABLED=false
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
# Exact registered HTTPS URL, including on a development tunnel or Preview.
SHOPIFY_CUSTOMER_ACCOUNT_REDIRECT_URI=
# Server-only encryption for persisted OAuth attempts and buyer tokens.
# JSON keyring of 32-byte, unpadded base64url keys; keep old IDs during rotation.
STORE_CUSTOMER_ACCOUNT_ENCRYPTION_KEY_ID=
STORE_CUSTOMER_ACCOUNT_ENCRYPTION_KEYS=
# Shared EmailJS configuration for the customer-support form.
NEXT_PUBLIC_EMAIL_SERVICE_ID=your-emailjs-service-id
NEXT_PUBLIC_EMAIL_TEMPLATE_ID=your-emailjs-template-id
NEXT_PUBLIC_EMAIL_USER_ID=your-emailjs-public-key

# Review attachments are enabled by default with configured RMT storage and buyer sign-in.
# Set false to pause collection without hiding already-approved public photos.
STORE_REVIEW_PHOTOS_ENABLED=true
