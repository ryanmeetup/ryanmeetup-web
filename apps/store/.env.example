SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=your-public-storefront-token
SHOPIFY_ADMIN_API_TOKEN=server-only-admin-token
# Signing secret for the webhook subscriptions (not an API access token).
SHOPIFY_WEBHOOK_SECRET=server-only-webhook-signing-secret
# Use the Shop domain shown in Judge.me's View API tokens modal.
JUDGEME_SHOP_DOMAIN=your-store.myshopify.com
JUDGEME_PUBLIC_TOKEN=your-public-widget-token
JUDGEME_PRIVATE_API_TOKEN=server-only-private-token
# Review reads AND submissions: judgeme (default) or custom (under construction).
# Restart dev / rebuild and deploy after changing this server-only setting.
REVIEWS_PROVIDER=judgeme
# Shared EmailJS configuration for the customer-support form.
NEXT_PUBLIC_EMAIL_SERVICE_ID=your-emailjs-service-id
NEXT_PUBLIC_EMAIL_TEMPLATE_ID=your-emailjs-template-id
NEXT_PUBLIC_EMAIL_USER_ID=your-emailjs-public-key
